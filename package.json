{
  "name": "campus-connect-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "predev": "node infrastructure/kill-ports.js",
    "dev": "turbo run dev start:dev --concurrency=20",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@10.0.0",
  "devDependencies": {
    "turbo": "latest"
  }
}
