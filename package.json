{
  "name": "campus-connect-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prisma:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "postinstall": "npm run prisma:generate",
    "prebuild": "npm run prisma:generate",
    "build": "node --env-file-if-exists=.env scripts/build.js",
    "build:workspaces": "node node_modules/turbo/bin/turbo run build --filter=!web-client",
    "build:web": "npm run build --workspace=web-client",
    "predev": "node infrastructure/kill-ports.js",
    "dev": "node --env-file-if-exists=.env node_modules/turbo/bin/turbo run dev start:dev --concurrency=20",
    "dev:cleanup": "node infrastructure/kill-ports.js --kill-owned",
    "dev:frontend": "node --env-file-if-exists=.env node_modules/turbo/bin/turbo run dev --filter=web-client",
    "dev:admin": "node --env-file-if-exists=.env node_modules/turbo/bin/turbo run dev --filter=admin-dashboard",
    "dev:web": "node --env-file-if-exists=.env node_modules/turbo/bin/turbo run dev --filter=web-client --filter=admin-dashboard",
    "dev:backend": "node --env-file-if-exists=.env node_modules/turbo/bin/turbo run start:dev --concurrency=20 --filter=!web-client --filter=!admin-dashboard",
    "db:push": "prisma db push --schema packages/database/prisma/schema.prisma",
    "db:studio": "prisma studio --schema packages/database/prisma/schema.prisma",
    "deploy:healthcheck": "node scripts/deploy-healthcheck.js",
    "deploy:web": "node scripts/deploy-web.js",
    "lint": "turbo run lint",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "test:infra": "node --test infrastructure/*.test.js",
    "test": "npm run test:infra && npm run test --workspaces --if-present"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@10.0.0",
  "devDependencies": {
    "turbo": "latest"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^5.1.1",
    "ioredis": "^5.11.1",
    "redis": "^6.1.0"
  }
}
