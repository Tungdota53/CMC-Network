generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(uuid()) @db.Uuid
  email                  String                  @unique
  emailVerified          Boolean                 @default(false)
  otpCode                String?
  otpExpiry              DateTime?
  passwordHash           String?
  authProvider           AuthProvider            @default(EMAIL)
  role                   Role                    @default(STUDENT)
  twoFactorStatus        TwoFactorStatus         @default(DISABLED)
  twoFactorSecret        String?
  fullName               String
  studentId              String?                 @unique
  department             String?
  major                  String?
  cohort                 String?
  bio                    String?
  avatarUrl              String?
  coverPhotoUrl          String?
  reputationScore        Int                     @default(0)
  isVerified             Boolean                 @default(false)
  hasBlueBadge           Boolean                 @default(false)
  isSuspended            Boolean                 @default(false)
  lastLoginAt            DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  location               String?
  banExpiresAt           DateTime?
  deletedAt              DateTime?
  violationStrikes       Int                     @default(0)
  auditLogsActed         AuditLog[]              @relation("AuditActor")
  auditLogsTargeted      AuditLog[]              @relation("AuditTarget")
  clubMemberships        ClubMember[]
  clubJoinRequests       ClubJoinRequest[]
  ownedClubs             Club[]                  @relation("ClubOwner")
  commentLikes           CommentLike[]
  comments               Comment[]
  conversationMembers    ConversationMember[]
  eventAttendees         EventAttendee[]
  events                 Event[]
  receivedFriendRequests FriendRequest[]         @relation("ReceivedFriendRequests")
  sentFriendRequests     FriendRequest[]         @relation("SentFriendRequests")
  friendships            Friendship[]            @relation("UserAFriendships")
  friendships2           Friendship[]            @relation("UserBFriendships")
  blocksInitiated        UserBlock[]             @relation("BlocksInitiated")
  blockedBy              UserBlock[]             @relation("BlockedBy")
  joinRequests           JoinRequest[]
  materialBookmarks      MaterialBookmark[]
  materialReviews        MaterialReview[]
  materials              Material[]
  mentorApplications     MentorApplication[]
  menteeBookings         MentorBooking[]         @relation("MenteeBookings")
  mentorBookings         MentorBooking[]         @relation("MentorBookings")
  mentorProfile          MentorProfile?
  gradeRecords           GradeRecord[]
  timetableEntries       TimetableEntry[]
  professorReviews       ProfessorReview[]
  givenMentorReviews     MentorReview[]          @relation("GivenMentorReviews")
  mentorReviews          MentorReview[]          @relation("MentorReviews")
  sentMessages           Message[]
  messageReactions       MessageReaction[]
  conversationStates     ConversationUserState[]
  messageDeletions       MessageDeletion[]
  messageReadReceipts    MessageReadReceipt[]
  pinnedMessages         PinnedMessage[]
  startedCallSessions    CallSession[]           @relation("CallStartedBy")
  notifications          Notification[]
  notificationPreference NotificationPreference?
  postLikes              PostLike[]
  postHides              PostHide[]
  postSaves              PostSave[]
  posts                  Post[]
  products               Product[]
  reports                Report[]
  reputationHistory      ReputationHistory[]
  storyViews             StoryView[]
  studyGroupMembers      StudyGroupMember[]
  studyGroups            StudyGroup[]
  studyRequests          StudyRequest[]
  achievements           UserAchievement[]
  badges                 UserBadge[]
  certificates           UserCertificate[]
  projects               UserProject[]
  skills                 UserSkill[]
  userViolations         UserViolation[]
  verificationRequests   VerificationRequest[]

  @@index([department])
  @@index([major])
  @@index([cohort])
  @@index([reputationScore])
  @@map("users")
}

model GradeRecord {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  subject     String
  subjectCode String?
  semester    String
  credits     Int
  grade10     Float
  letter      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, semester])
  @@map("grade_records")
}

model TimetableEntry {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  title       String
  classCode   String?
  room        String?
  lecturer    String?
  dayOfWeek   Int
  startTime   String
  endTime     String
  color       String?  @default("#8b5cf6")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayOfWeek])
  @@index([classCode])
  @@map("timetable_entries")
}

model Professor {
  id          String            @id @default(uuid()) @db.Uuid
  name        String
  faculty     String?
  department  String?
  avatarUrl   String?
  bio         String?
  rating      Float             @default(0)
  reviewCount Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  reviews     ProfessorReview[]

  @@index([faculty])
  @@index([rating(sort: Desc)])
  @@map("professors")
}

model ProfessorReview {
  id          String    @id @default(uuid()) @db.Uuid
  professorId String    @db.Uuid
  userId      String    @db.Uuid
  rating      Int
  difficulty  Int       @default(3)
  subject     String?
  content     String?
  createdAt   DateTime  @default(now())
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([professorId, userId])
  @@index([professorId])
  @@map("professor_reviews")
}

model FriendRequest {
  id         String   @id @default(uuid()) @db.Uuid
  senderId   String   @db.Uuid
  receiverId String   @db.Uuid
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  receiver   User     @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User     @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@map("friend_requests")
}

model Friendship {
  id        String   @id @default(uuid()) @db.Uuid
  userAId   String   @db.Uuid
  userBId   String   @db.Uuid
  createdAt DateTime @default(now())
  userA     User     @relation("UserAFriendships", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("UserBFriendships", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@map("friendships")
}

model UserBlock {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())
  blocker   User     @relation("BlocksInitiated", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("user_blocks")
}

model UserSkill {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  skill  String
  level  String @default("beginner")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skill])
  @@map("user_skills")
}

model UserAchievement {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  title       String
  description String?
  earnedAt    DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_achievements")
}

model UserCertificate {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  name          String
  issuer        String
  issuedAt      DateTime
  credentialUrl String?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_certificates")
}

model UserProject {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  title       String
  description String?
  techStack   String[]
  githubUrl   String?
  demoUrl     String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_projects")
}

model Post {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  type          PostType       @default(TEXT)
  content       String
  mediaUrls     String[]
  pollOptions   Json?
  pollVoters    String[]
  visibility    PostVisibility @default(PUBLIC)
  likes         Int            @default(0)
  commentCount  Int            @default(0)
  shareCount    Int            @default(0)
  saveCount     Int            @default(0)
  commentLocked Boolean        @default(false)
  sharedFromId  String?        @db.Uuid
  clubId        String?        @db.Uuid
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  club          Club?          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  comments      Comment[]
  hides         PostHide[]
  likesRel      PostLike[]
  saves         PostSave[]
  sharedFrom    Post?          @relation("SharedPost", fields: [sharedFromId], references: [id])
  sharedBy      Post[]         @relation("SharedPost")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  storySeenBy   StoryView[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([clubId, createdAt(sort: Desc)])
  @@index([type])
  @@index([visibility, createdAt(sort: Desc)])
  @@map("posts")
}

model StoryView {
  id      String   @id @default(uuid()) @db.Uuid
  storyId String   @db.Uuid
  userId  String   @db.Uuid
  seenAt  DateTime @default(now())
  story   Post     @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@index([storyId])
  @@map("story_views")
}

model PostLike {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  type      String   @default("LIKE")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_likes")
}

model PostHide {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("post_hides")
}

model PostSave {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_saves")
}

model Comment {
  id        String        @id @default(uuid()) @db.Uuid
  postId    String        @db.Uuid
  userId    String        @db.Uuid
  content   String
  parentId  String?       @db.Uuid
  likes     Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?
  likesRel  CommentLike[]
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentReplies")
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([parentId])
  @@map("comments")
}

model CommentLike {
  id        String   @id @default(uuid()) @db.Uuid
  commentId String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("comment_likes")
}

model StudyGroup {
  id             String             @id @default(uuid()) @db.Uuid
  creatorId      String             @db.Uuid
  title          String
  subject        String
  description    String?
  location       String
  maxMembers     Int
  scheduledTime  DateTime
  schedule       String?
  status         StudyGroupStatus   @default(OPEN)
  memberCount    Int                @default(1)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  conversationId String?            @unique @db.Uuid
  todoList       Json?
  type           StudyGroupType     @default(STUDY)
  whiteboardData Json?
  joinRequests   JoinRequest[]
  members        StudyGroupMember[]
  conversation   Conversation?      @relation(fields: [conversationId], references: [id])
  creator        User               @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([subject])
  @@index([status])
  @@index([creatorId])
  @@map("study_groups")
}

model StudyGroupMember {
  id       String     @id @default(uuid()) @db.Uuid
  groupId  String     @db.Uuid
  userId   String     @db.Uuid
  role     String     @default("member")
  joinedAt DateTime   @default(now())
  group    StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("study_group_members")
}

model JoinRequest {
  id        String            @id @default(uuid()) @db.Uuid
  groupId   String            @db.Uuid
  userId    String            @db.Uuid
  status    JoinRequestStatus @default(PENDING)
  createdAt DateTime          @default(now())
  group     StudyGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("join_requests")
}

model Material {
  id            String             @id @default(uuid()) @db.Uuid
  uploaderId    String             @db.Uuid
  title         String
  description   String?
  s3Url         String
  subject       String
  semester      String?
  fileType      FileType
  fileSize      String?
  downloadCount Int                @default(0)
  rating        Float              @default(0)
  reviewCount   Int                @default(0)
  aiSummary     String?
  aiFlashcards  Json?
  aiQuizQuestions Json?
  aiGeneratedAt DateTime?
  tags          String[]
  createdAt     DateTime           @default(now())
  deletedAt     DateTime?
  isOfficial    Boolean            @default(false)
  status        MaterialStatus     @default(PROCESSING)
  bookmarks     MaterialBookmark[]
  reviews       MaterialReview[]
  uploader      User               @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([subject, fileType])
  @@index([uploaderId])
  @@index([rating(sort: Desc)])
  @@index([downloadCount(sort: Desc)])
  @@map("materials")
}

model MaterialBookmark {
  id         String   @id @default(uuid()) @db.Uuid
  materialId String   @db.Uuid
  userId     String   @db.Uuid
  createdAt  DateTime @default(now())
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([materialId, userId])
  @@map("material_bookmarks")
}

model MaterialReview {
  id         String   @id @default(uuid()) @db.Uuid
  materialId String   @db.Uuid
  userId     String   @db.Uuid
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([materialId, userId])
  @@map("material_reviews")
}

model MentorProfile {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @unique @db.Uuid
  bio           String?
  expertise     String[]
  gpa           Float?
  totalSessions Int          @default(0)
  rating        Float        @default(0)
  reviewCount   Int          @default(0)
  status        MentorStatus @default(ACTIVE)
  schedule      Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mentor_profiles")
}

model MentorBooking {
  id          String        @id @default(uuid()) @db.Uuid
  mentorId    String        @db.Uuid
  menteeId    String        @db.Uuid
  scheduledAt DateTime
  topic       String?
  status      BookingStatus @default(PENDING)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  mentee      User          @relation("MenteeBookings", fields: [menteeId], references: [id], onDelete: Cascade)
  mentor      User          @relation("MentorBookings", fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([mentorId])
  @@index([menteeId])
  @@index([status])
  @@map("mentor_bookings")
}

model MentorReview {
  id        String   @id @default(uuid()) @db.Uuid
  mentorId  String   @db.Uuid
  menteeId  String   @db.Uuid
  bookingId String   @unique @db.Uuid
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  mentee    User     @relation("GivenMentorReviews", fields: [menteeId], references: [id], onDelete: Cascade)
  mentor    User     @relation("MentorReviews", fields: [mentorId], references: [id], onDelete: Cascade)

  @@map("mentor_reviews")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  sellerId    String        @db.Uuid
  title       String
  description String
  price       Decimal       @db.Decimal(10, 2)
  category    String
  condition   String
  images      String[]
  location    String?
  status      ProductStatus @default(AVAILABLE)
  buyerId     String?       @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  seller      User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([status])
  @@index([sellerId])
  @@map("products")
}

model Event {
  id            String          @id @default(uuid()) @db.Uuid
  organizerId   String          @db.Uuid
  title         String
  description   String?
  type          String
  location      String
  startDate     DateTime
  endDate       DateTime
  maxAttendees  Int?
  attendeeCount Int             @default(0)
  status        EventStatus     @default(DRAFT)
  qrCodeEnabled Boolean         @default(false)
  image         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  attendees     EventAttendee[]
  organizer     User            @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([status])
  @@index([startDate])
  @@map("events")
}

model EventAttendee {
  id          String           @id @default(uuid()) @db.Uuid
  eventId     String           @db.Uuid
  userId      String           @db.Uuid
  status      AttendanceStatus @default(REGISTERED)
  qrCode      String?          @unique
  checkedInAt DateTime?
  createdAt   DateTime         @default(now())
  event       Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_attendees")
}

model Conversation {
  id             String                  @id @default(uuid()) @db.Uuid
  type           ConversationType        @default(DIRECT)
  name           String?
  avatar         String?
  backgroundUrl  String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  members        ConversationMember[]
  messages       Message[]
  userStates     ConversationUserState[]
  pinnedMessages PinnedMessage[]
  callSessions   CallSession[]
  studyGroup     StudyGroup?

  @@map("conversations")
}

model ConversationMember {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  userId         String       @db.Uuid
  role           String       @default("member")
  joinedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_members")
}

model Message {
  id             String               @id @default(uuid()) @db.Uuid
  conversationId String               @db.Uuid
  senderId       String               @db.Uuid
  content        String
  messageType    String               @default("text")
  mediaUrl       String?
  status         MessageStatus        @default(SENT)
  replyToId      String?              @db.Uuid
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  conversation   Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User                 @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo        Message?             @relation("MessageReplies", fields: [replyToId], references: [id])
  replies        Message[]            @relation("MessageReplies")
  reactions      MessageReaction[]
  deletions      MessageDeletion[]
  readReceipts   MessageReadReceipt[]
  pinnedBy       PinnedMessage[]

  @@index([conversationId, createdAt(sort: Desc)])
  @@map("messages")
}

model MessageReaction {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@map("message_reactions")
}

model ConversationUserState {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  userId         String       @db.Uuid
  isArchived     Boolean      @default(false)
  isMuted        Boolean      @default(false)
  isPinned       Boolean      @default(false)
  lastReadAt     DateTime?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, isArchived])
  @@index([userId, isPinned])
  @@map("conversation_user_states")
}

model MessageDeletion {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  deletedAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
  @@map("message_deletions")
}

model MessageReadReceipt {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  readAt    DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, readAt])
  @@map("message_read_receipts")
}

model PinnedMessage {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  messageId      String       @db.Uuid
  userId         String       @db.Uuid
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, messageId])
  @@index([conversationId, createdAt])
  @@map("pinned_messages")
}

model CallSession {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  startedById    String       @db.Uuid
  callType       String
  status         String       @default("started")
  startedAt      DateTime     @default(now())
  endedAt        DateTime?
  durationSec    Int?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  startedBy      User         @relation("CallStartedBy", fields: [startedById], references: [id], onDelete: Cascade)

  @@index([conversationId, startedAt(sort: Desc)])
  @@index([startedById, startedAt(sort: Desc)])
  @@map("call_sessions")
}

model UserBadge {
  id       String    @id @default(uuid()) @db.Uuid
  userId   String    @db.Uuid
  badge    BadgeType
  earnedAt DateTime  @default(now())
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badge])
  @@map("user_badges")
}

model ReputationHistory {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  action    ReputationAction
  points    Int
  reason    String?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("reputation_history")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  content   String
  isRead    Boolean          @default(false)
  relatedId String?          @db.Uuid
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}

model NotificationPreference {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @db.Uuid
  likes          Boolean  @default(true)
  comments       Boolean  @default(true)
  mentions       Boolean  @default(true)
  friendRequests Boolean  @default(true)
  system         Boolean  @default(true)
  push           Boolean  @default(true)
  email          Boolean  @default(false)
  quietHours     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model Report {
  id         String       @id @default(uuid()) @db.Uuid
  reporterId String       @db.Uuid
  targetId   String       @db.Uuid
  targetType ReportType
  reason     String
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("reports")
}

model SystemConfig {
  key   String @id
  value String

  @@map("system_configs")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String   @db.Uuid
  targetId  String?  @db.Uuid
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
  actor     User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  target    User?    @relation("AuditTarget", fields: [targetId], references: [id])

  @@index([actorId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

model UserViolation {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  reason      String
  strikeLevel Int
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_violations")
}

model VerificationRequest {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  type      String
  documents String[]
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("verification_requests")
}

model MentorApplication {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  status    String   @default("PENDING")
  documents String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mentor_applications")
}

model Club {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  description  String?
  category     String?
  type         String       @default("COMMUNITY")
  visibility   String       @default("PUBLIC")
  joinMode     String       @default("OPEN")
  logoUrl      String?
  bannerUrl    String?
  rules        String?
  tags         String[]     @default([])
  location     String?
  contactEmail String?
  socialLinks  Json?
  featured     Boolean      @default(false)
  status       String       @default("ACTIVE")
  verifiedAt   DateTime?
  ownerId      String       @db.Uuid
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  members      ClubMember[]
  joinRequests ClubJoinRequest[]
  posts        Post[]
  owner        User         @relation("ClubOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([type])
  @@index([status])
  @@index([featured])
  @@index([createdAt])
  @@map("clubs")
}

model ClubJoinRequest {
  id        String   @id @default(uuid()) @db.Uuid
  clubId    String   @db.Uuid
  userId    String   @db.Uuid
  status    String   @default("PENDING")
  message   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([clubId, status, createdAt])
  @@index([userId, status])
  @@map("club_join_requests")
}

model ClubMember {
  id       String   @id @default(uuid()) @db.Uuid
  clubId   String   @db.Uuid
  userId   String   @db.Uuid
  role     String   @default("MEMBER")
  joinedAt DateTime @default(now())
  club     Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@map("club_members")
}

model StudyRequest {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @db.Uuid
  title             String
  description       String?
  subject           String?
  type              StudyRequestType @default(FIND_PARTNER)
  preferredTime     String?
  preferredLocation String?
  status            RequestStatus    @default(ACTIVE)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([subject])
  @@index([status])
  @@index([userId])
  @@map("study_requests")
}

