generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String               @id @default(uuid()) @db.Uuid
  email                  String               @unique
  emailVerified          Boolean              @default(false)
  otpCode                String?
  otpExpiry              DateTime?
  passwordHash           String?
  authProvider           AuthProvider         @default(EMAIL)
  role                   Role                 @default(STUDENT)
  twoFactorStatus        TwoFactorStatus      @default(DISABLED)
  twoFactorSecret        String?
  fullName               String
  studentId              String?              @unique
  department             String?
  major                  String?
  cohort                 String?
  bio                    String?
  avatarUrl              String?
  coverPhotoUrl          String?
  location               String?
  reputationScore        Int                  @default(0)
  isVerified             Boolean              @default(false)
  isSuspended            Boolean              @default(false)
  lastLoginAt            DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  commentLikes           CommentLike[]
  comments               Comment[]
  conversationMembers    ConversationMember[]
  eventAttendees         EventAttendee[]
  events                 Event[]
  receivedFriendRequests FriendRequest[]      @relation("ReceivedFriendRequests")
  sentFriendRequests     FriendRequest[]      @relation("SentFriendRequests")
  friendships            Friendship[]         @relation("UserAFriendships")
  friendships2           Friendship[]         @relation("UserBFriendships")
  joinRequests           JoinRequest[]
  materialBookmarks      MaterialBookmark[]
  materialReviews        MaterialReview[]
  materials              Material[]
  menteeBookings         MentorBooking[]      @relation("MenteeBookings")
  mentorBookings         MentorBooking[]      @relation("MentorBookings")
  mentorProfile          MentorProfile?
  givenMentorReviews     MentorReview[]       @relation("GivenMentorReviews")
  mentorReviews          MentorReview[]       @relation("MentorReviews")
  sentMessages           Message[]
  postLikes              PostLike[]
  postSaves              PostSave[]
  posts                  Post[]
  products               Product[]
  reputationHistory      ReputationHistory[]
  studyGroupMembers      StudyGroupMember[]
  studyGroups            StudyGroup[]
  achievements           UserAchievement[]
  badges                 UserBadge[]
  certificates           UserCertificate[]
  projects               UserProject[]
  skills                 UserSkill[]
  notifications          Notification[]
  reports                Report[]

  @@index([department])
  @@index([major])
  @@index([cohort])
  @@index([reputationScore])
  @@map("users")
}

model FriendRequest {
  id         String   @id @default(uuid()) @db.Uuid
  senderId   String   @db.Uuid
  receiverId String   @db.Uuid
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  receiver   User     @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User     @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@map("friend_requests")
}

model Friendship {
  id        String   @id @default(uuid()) @db.Uuid
  userAId   String   @db.Uuid
  userBId   String   @db.Uuid
  createdAt DateTime @default(now())
  userA     User     @relation("UserAFriendships", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("UserBFriendships", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@map("friendships")
}

model UserSkill {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  skill  String
  level  String @default("beginner")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skill])
  @@map("user_skills")
}

model UserAchievement {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  title       String
  description String?
  earnedAt    DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_achievements")
}

model UserCertificate {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  name          String
  issuer        String
  issuedAt      DateTime
  credentialUrl String?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_certificates")
}

model UserProject {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  title       String
  description String?
  techStack   String[]
  githubUrl   String?
  demoUrl     String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_projects")
}

model Post {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @db.Uuid
  type         PostType       @default(TEXT)
  content      String
  mediaUrls    String[]
  pollOptions  Json?
  pollVoters   String[]
  visibility   PostVisibility @default(PUBLIC)
  likes        Int            @default(0)
  commentCount Int            @default(0)
  shareCount   Int            @default(0)
  saveCount    Int            @default(0)
  sharedFromId String?        @db.Uuid
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  comments     Comment[]
  likesRel     PostLike[]
  saves        PostSave[]
  sharedFrom   Post?          @relation("SharedPost", fields: [sharedFromId], references: [id])
  sharedBy     Post[]         @relation("SharedPost")
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@index([type])
  @@map("posts")
}

model PostLike {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  type      String   @default("LIKE")
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_likes")
}

model PostSave {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_saves")
}

model Comment {
  id        String        @id @default(uuid()) @db.Uuid
  postId    String        @db.Uuid
  userId    String        @db.Uuid
  content   String
  parentId  String?       @db.Uuid
  likes     Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  likesRel  CommentLike[]
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentReplies")
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([parentId])
  @@map("comments")
}

model CommentLike {
  id        String   @id @default(uuid()) @db.Uuid
  commentId String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("comment_likes")
}

model StudyGroup {
  id            String             @id @default(uuid()) @db.Uuid
  creatorId     String             @db.Uuid
  title         String
  subject       String
  description   String?
  location      String
  maxMembers    Int
  scheduledTime DateTime
  schedule      String?
  status        StudyGroupStatus   @default(OPEN)
  memberCount   Int                @default(1)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  joinRequests  JoinRequest[]
  members       StudyGroupMember[]
  creator       User               @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([subject])
  @@index([status])
  @@index([creatorId])
  @@map("study_groups")
}

model StudyGroupMember {
  id       String     @id @default(uuid()) @db.Uuid
  groupId  String     @db.Uuid
  userId   String     @db.Uuid
  role     String     @default("member")
  joinedAt DateTime   @default(now())
  group    StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("study_group_members")
}

model JoinRequest {
  id        String            @id @default(uuid()) @db.Uuid
  groupId   String            @db.Uuid
  userId    String            @db.Uuid
  status    JoinRequestStatus @default(PENDING)
  createdAt DateTime          @default(now())
  group     StudyGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("join_requests")
}

model Material {
  id            String             @id @default(uuid()) @db.Uuid
  uploaderId    String             @db.Uuid
  title         String
  description   String?
  s3Url         String
  subject       String
  semester      String?
  fileType      FileType
  fileSize      String?
  downloadCount Int                @default(0)
  rating        Float              @default(0)
  reviewCount   Int                @default(0)
  aiSummary     String?
  tags          String[]
  createdAt     DateTime           @default(now())
  bookmarks     MaterialBookmark[]
  reviews       MaterialReview[]
  uploader      User               @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([subject])
  @@index([fileType])
  @@index([uploaderId])
  @@index([rating(sort: Desc)])
  @@index([downloadCount(sort: Desc)])
  @@map("materials")
}

model MaterialBookmark {
  id         String   @id @default(uuid()) @db.Uuid
  materialId String   @db.Uuid
  userId     String   @db.Uuid
  createdAt  DateTime @default(now())
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([materialId, userId])
  @@map("material_bookmarks")
}

model MaterialReview {
  id         String   @id @default(uuid()) @db.Uuid
  materialId String   @db.Uuid
  userId     String   @db.Uuid
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([materialId, userId])
  @@map("material_reviews")
}

model MentorProfile {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @unique @db.Uuid
  bio           String?
  expertise     String[]
  gpa           Float?
  totalSessions Int          @default(0)
  rating        Float        @default(0)
  reviewCount   Int          @default(0)
  status        MentorStatus @default(ACTIVE)
  schedule      Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mentor_profiles")
}

model MentorBooking {
  id          String        @id @default(uuid()) @db.Uuid
  mentorId    String        @db.Uuid
  menteeId    String        @db.Uuid
  scheduledAt DateTime
  topic       String?
  status      BookingStatus @default(PENDING)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  mentee      User          @relation("MenteeBookings", fields: [menteeId], references: [id], onDelete: Cascade)
  mentor      User          @relation("MentorBookings", fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([mentorId])
  @@index([menteeId])
  @@index([status])
  @@map("mentor_bookings")
}

model MentorReview {
  id        String   @id @default(uuid()) @db.Uuid
  mentorId  String   @db.Uuid
  menteeId  String   @db.Uuid
  bookingId String   @unique @db.Uuid
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  mentee    User     @relation("GivenMentorReviews", fields: [menteeId], references: [id], onDelete: Cascade)
  mentor    User     @relation("MentorReviews", fields: [mentorId], references: [id], onDelete: Cascade)

  @@map("mentor_reviews")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  sellerId    String        @db.Uuid
  title       String
  description String
  price       Decimal       @db.Decimal(10, 2)
  category    String
  condition   String
  images      String[]
  location    String?
  status      ProductStatus @default(AVAILABLE)
  buyerId     String?       @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  seller      User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([status])
  @@index([sellerId])
  @@map("products")
}

model Event {
  id            String          @id @default(uuid()) @db.Uuid
  organizerId   String          @db.Uuid
  title         String
  description   String?
  type          String
  location      String
  startDate     DateTime
  endDate       DateTime
  maxAttendees  Int?
  attendeeCount Int             @default(0)
  status        EventStatus     @default(DRAFT)
  qrCodeEnabled Boolean         @default(false)
  image         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  attendees     EventAttendee[]
  organizer     User            @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([status])
  @@index([startDate])
  @@map("events")
}

model EventAttendee {
  id          String           @id @default(uuid()) @db.Uuid
  eventId     String           @db.Uuid
  userId      String           @db.Uuid
  status      AttendanceStatus @default(REGISTERED)
  qrCode      String?          @unique
  checkedInAt DateTime?
  createdAt   DateTime         @default(now())
  event       Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_attendees")
}

model Conversation {
  id        String               @id @default(uuid()) @db.Uuid
  type      ConversationType     @default(DIRECT)
  name      String?
  avatar    String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  members   ConversationMember[]
  messages  Message[]

  @@map("conversations")
}

model ConversationMember {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  userId         String       @db.Uuid
  role           String       @default("member")
  joinedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_members")
}

model Message {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @db.Uuid
  senderId       String        @db.Uuid
  content        String
  messageType    String        @default("text")
  mediaUrl       String?
  status         MessageStatus @default(SENT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt(sort: Desc)])
  @@map("messages")
}

model UserBadge {
  id       String    @id @default(uuid()) @db.Uuid
  userId   String    @db.Uuid
  badge    BadgeType
  earnedAt DateTime  @default(now())
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badge])
  @@map("user_badges")
}

model ReputationHistory {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  action    ReputationAction
  points    Int
  reason    String?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("reputation_history")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
  CLUB_LEADER
}

enum AuthProvider {
  EMAIL
  GOOGLE
  MICROSOFT
}

enum TwoFactorStatus {
  DISABLED
  ENABLED
}

enum BadgeType {
  MENTOR_EXCELLENT
  EXPERT_JAVA
  EXPERT_REACT
  EXPERT_AI
  ACTIVE_SHARER
  TOP_CONTRIBUTOR
  HELPFUL_MENTEE
  EVENT_ORGANIZER
  MARKETPLACE_TRUSTED
  EARLY_ADOPTER
}

enum ReputationAction {
  POST_CREATED
  COMMENT_CREATED
  MATERIAL_UPLOADED
  MATERIAL_DOWNLOADED
  MENTOR_SESSION_COMPLETED
  EVENT_ORGANIZED
  EVENT_ATTENDED
  PRODUCT_SOLD
  HELPFUL_ANSWER
  REPORT_SUBMITTED
  REPORT_RESOLVED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ONGOING
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  REGISTERED
  CHECKED_IN
  ABSENT
}

enum MentorStatus {
  ACTIVE
  BUSY
  INACTIVE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PostType {
  TEXT
  IMAGE
  VIDEO
  FILE
  POLL
  SHARE
  STORY
}

enum PostVisibility {
  PUBLIC
  FRIENDS
  PRIVATE
}

enum ConversationType {
  DIRECT
  GROUP
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

enum StudyGroupStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  FULL
  CANCELLED
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FileType {
  PDF
  DOCX
  PPTX
  XLSX
  ZIP
  OTHER
}

enum ProductStatus {
  AVAILABLE
  SOLD
  RESERVED
  REMOVED
}

model Notification {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @db.Uuid
  type      NotificationType
  content   String
  isRead    Boolean            @default(false)
  relatedId String?            @db.Uuid
  createdAt DateTime           @default(now())
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}

model Report {
  id          String       @id @default(uuid()) @db.Uuid
  reporterId  String       @db.Uuid
  targetId    String       @db.Uuid
  targetType  ReportType
  reason      String
  status      ReportStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  reporter    User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("reports")
}

enum NotificationType {
  LIKE
  COMMENT
  FRIEND_REQUEST
  FRIEND_ACCEPT
  SYSTEM
  MENTION
}

enum ReportType {
  POST
  USER
  COMMENT
  PRODUCT
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}
