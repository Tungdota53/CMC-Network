# auth-service
PORT=22022
DATABASE_URL=postgresql://campus_connect:campus_connect_dev@localhost:25432/campus_connect?schema=public
REDIS_URL=redis://localhost:26379
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d
ALLOWED_ORIGINS=http://localhost:25080
FRONTEND_URL=http://localhost:25080
ALLOWED_EMAIL_DOMAINS=st.cmc.edu.vn,st.cmcu.edu.vn,cmc.edu.vn
OTP_SECRET=change-me-to-a-long-random-secret
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
ALLOW_OTP_LOGGING=false
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=CMC Network <no-reply@example.com>
SMTP_TIMEOUT_MS=10000

# Microsoft Azure AD SSO (portal.azure.com -> App registrations)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
# Public callback URL (set to your deployed domain in production)
MICROSOFT_CALLBACK_URL=http://localhost:22022/auth/microsoft/callback
