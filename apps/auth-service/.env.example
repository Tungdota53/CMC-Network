# auth-service
PORT=22022
DATABASE_URL=postgresql://campus_admin:campus_password@localhost:5432/campus_connect
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d
ALLOWED_ORIGINS=http://localhost:25080,http://localhost:25443
FRONTEND_URL=http://localhost:25080

# Microsoft Azure AD SSO (portal.azure.com -> App registrations)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
# Public callback URL (set to your deployed domain in production)
MICROSOFT_CALLBACK_URL=http://localhost:22022/auth/microsoft/callback
