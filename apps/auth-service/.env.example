# Microsoft Azure AD Single Sign-On (SSO) Keys
# Lấy các thông số này tại trang quản trị: portal.azure.com (Azure Active Directory -> App registrations)

MICROSOFT_CLIENT_ID=nhap-client-id-cua-ban-vao-day
MICROSOFT_CLIENT_SECRET=nhap-client-secret-cua-ban-vao-day
MICROSOFT_TENANT_ID=common

# Lưu ý: 
# - Nếu trường của bạn chỉ cho phép sinh viên nội bộ đăng nhập, hãy thay chữ "common" 
#   bằng ID (Tenant ID) riêng của Đại học CMC.
# - Sau khi lấy được key, hãy đổi tên file này thành .env
