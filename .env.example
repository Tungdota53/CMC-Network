# CampusConnect local environment
# Copy this file to `.env`. Root npm scripts load it automatically.

# ---- Isolated local infrastructure ----
POSTGRES_USER=campus_connect
POSTGRES_PASSWORD=campus_connect_dev
POSTGRES_DB=campus_connect
POSTGRES_HOST_PORT=25432
DATABASE_URL=postgresql://campus_connect:campus_connect_dev@localhost:25432/campus_connect?schema=public

REDIS_HOST_PORT=26379
REDIS_URL=redis://localhost:26379

# ---- HTTP abuse protection ----
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MS=900000
REQUEST_BODY_LIMIT=256kb

# ---- Local application origins ----
ALLOWED_ORIGINS=http://localhost:25080
FRONTEND_URL=http://localhost:25080
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:25021

# Next.js direct asset/socket rewrites
USER_API_URL=http://localhost:23306
POSTS_API_URL=http://localhost:38888
CHAT_API_URL=http://localhost:38080
MATERIAL_API_URL=http://localhost:38082
MARKETPLACE_API_URL=http://localhost:38083

# ---- Service discovery: API gateway -> services ----
AUTH_SERVICE_URL=http://localhost:22022
USER_SERVICE_URL=http://localhost:23306
SOCIAL_SERVICE_URL=http://localhost:38888
CHAT_SERVICE_URL=http://localhost:38080
STUDY_SERVICE_URL=http://localhost:38081
MATERIAL_SERVICE_URL=http://localhost:38082
MARKETPLACE_SERVICE_URL=http://localhost:38083
AI_SERVICE_URL=http://localhost:8000/api/v1

# ---- Authentication ----
# Replace both values outside local development.
JWT_SECRET=local-only-change-before-deploy
JWT_EXPIRES_IN=15m
ALLOWED_EMAIL_DOMAINS=st.cmc.edu.vn,st.cmcu.edu.vn,cmc.edu.vn
OTP_SECRET=local-only-change-before-deploy
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
ALLOW_OTP_LOGGING=true

# Microsoft Azure AD SSO
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_CALLBACK_URL=http://localhost:22022/auth/microsoft/callback

# Email delivery. With no credentials, use OTP logging only in local development.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=CMC Network <no-reply@example.com>
SMTP_TIMEOUT_MS=10000

# ---- Storage ----
# local | s3 | cloudinary | r2  (only 'local' implemented; others throw)
STORAGE_DRIVER=local
# Persistent directory outside the source tree. Docker Compose overrides this
# with /var/lib/campus-connect/uploads and mounts the named `uploads` volume.
UPLOAD_ROOT=/var/lib/campus-connect/uploads
# Optional absolute CDN origin. Leave empty to keep current relative URLs.
UPLOAD_PUBLIC_BASE_URL=
# S3 / R2 (when STORAGE_DRIVER=s3|r2)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=            # R2: https://<accountid>.r2.cloudflarestorage.com
# Cloudinary (when STORAGE_DRIVER=cloudinary)
# CLOUDINARY_URL=

# ---- AI assistant ----
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
