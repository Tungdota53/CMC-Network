# ============================================================
# CampusConnect — Root environment template
# Copy to `.env` and fill in real values before deploying.
# ============================================================

# ---- Database (Prisma) ----
# Used by every service via @campus-connect/database.
# Default credentials work for BOTH:
#   - Postgres installed locally (user: postgres / password: 703050)
#   - Docker compose (postgres + redis) — compose reads same defaults via env
# Override here if your local Postgres uses different credentials.
DATABASE_URL=postgresql://postgres:703050@localhost:5432/campus_connect?schema=public

# Compose-only overrides (optional). docker-compose.yml falls back to the same
# defaults as DATABASE_URL above, so you usually don't need to set these.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=703050
# POSTGRES_DB=campus_connect

# ---- Redis (cache / future socket adapter) ----
REDIS_URL=redis://localhost:6379

# ---- Auth / JWT (MUST be a strong random secret in production) ----
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d

# ---- CORS ----
# Comma-separated list of allowed origins. Use '*' only for local dev.
# Example: https://campus.cmc.edu.vn,https://admin.campus.cmc.edu.vn
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Frontend URL (used by auth-service OAuth redirects) ----
FRONTEND_URL=http://localhost:3000

# ---- Service discovery (api-gateway -> services) ----
AUTH_SERVICE_URL=http://localhost:3002
USER_SERVICE_URL=http://localhost:3003
SOCIAL_SERVICE_URL=http://localhost:3004
CHAT_SERVICE_URL=http://localhost:3005
STUDY_SERVICE_URL=http://localhost:3006
MATERIAL_SERVICE_URL=http://localhost:3007
MARKETPLACE_SERVICE_URL=http://localhost:3008

# ---- Storage ----
# local | s3 | cloudinary | r2  (only 'local' implemented; others throw)
STORAGE_DRIVER=local
# S3 / R2 (when STORAGE_DRIVER=s3|r2)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=            # R2: https://<accountid>.r2.cloudflarestorage.com
# Cloudinary (when STORAGE_DRIVER=cloudinary)
# CLOUDINARY_URL=

# ---- Microsoft SSO (auth-service) ----
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ---- AI Assistant (web-client /api/ai) ----
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
